{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-harness.local/schemas/role-mapping.schema.json",
  "title": "Role → preset/toolFilter mapping",
  "description": "Declarative mapping from role definitions to DSH Agent Presets + per-role tool-subagent instances (config/role-preset-mapping.yaml). Control-plane input; NOTHING here is mounted. Tool names verified against DSH 0.1.1-rc.2 catalog.",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_version", "status", "version_pin", "documentation_ref", "preset_naming_convention", "instance_naming_convention", "roles", "orchestrator", "consistency_rules"],
  "properties": {
    "mapping_version": { "type": "integer", "minimum": 1 },
    "status": { "const": "finalized" },
    "version_pin": { "type": "string", "pattern": "^deepseek-harness-" },
    "documentation_ref": { "type": "string" },
    "preset_naming_convention": { "type": "string" },
    "instance_naming_convention": { "type": "string" },
    "roles": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/roleEntry" }
    },
    "orchestrator": { "$ref": "#/$defs/orchestratorEntry" },
    "consistency_rules": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "draft_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "preset_draft_path", "instances_draft_path", "orchestrator_preset", "mount_required"],
      "properties": {
        "status": { "const": "draft" },
        "preset_draft_path": { "type": "string" },
        "instances_draft_path": { "type": "string" },
        "orchestrator_preset": { "type": "string" },
        "mount_required": { "type": "boolean", "const": false }
      }
    }
  },
  "$defs": {
    "roleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "preset", "policy_ref", "tool_instance", "tool_filter"],
      "properties": {
        "id": { "enum": ["zeko", "cto", "cfo", "kai", "somad", "badsector", "nova"] },
        "preset": { "type": "string", "pattern": "^role-[a-z]+$" },
        "policy_ref": { "type": "string", "pattern": "^agents/[a-z]+/policy\\.yaml$" },
        "tool_instance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_name", "provider", "background_mode", "max_depth", "persona"],
          "properties": {
            "tool_name": { "type": "string", "pattern": "^subagent_[a-z]+$" },
            "provider": { "const": "spawn" },
            "background_mode": { "enum": ["continuable", "one-shot"] },
            "max_depth": { "type": "integer", "minimum": 1 },
            "persona": { "type": "string" }
          }
        },
        "tool_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "deny": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "orchestratorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "binding", "policy_ref", "delegation_tools", "tool_filter"],
      "properties": {
        "id": { "const": "orchestrator" },
        "binding": { "const": "root_session" },
        "policy_ref": { "type": "string" },
        "delegation_tools": {
          "type": "array",
          "items": { "enum": ["subagent", "subagent_fork", "send_message", "interrupt_agent", "list_agents", "workflow"] }
        },
        "tool_filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "deny": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "notes": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
