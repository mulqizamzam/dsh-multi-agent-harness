{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-harness.local/schemas/role-mapping.schema.json",
  "title": "Role → Agent Preset / tool surface mapping",
  "description": "Declarative mapping from role definitions to DSH Agent Presets (config/role-preset-mapping.yaml). DSH 0.2.1-rc.2 removed the per-instance persona and tool-filter config keys from @deepseek-ai/dsh-tool-subagent, so a role is reached by SELECTING its Agent Preset through the model-facing agent_preset argument of the one delegation tool; the tool surface below is the set of tool PLUGINS the role's preset mounts. draft_artifacts.status records the mount lifecycle: 'draft' (pre-2026-09-07) or 'mounted' (Human-approved D4/D7 exception executed 2026-09-07). Tool names verified against the DSH 0.2.1-rc.2 catalog.",
  "x-schema-version": 4,
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_version", "status", "version_pin", "documentation_ref", "preset_naming_convention", "instance_naming_convention", "roles", "orchestrator", "consistency_rules"],
  "properties": {
    "mapping_version": { "type": "integer", "minimum": 1 },
    "status": { "const": "finalized" },
    "version_pin": { "type": "string", "pattern": "^deepseek-harness-" },
    "documentation_ref": { "type": "string" },
    "preset_naming_convention": { "type": "string" },
    "instance_naming_convention": { "type": "string" },
    "roles": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/roleEntry" }
    },
    "orchestrator": { "$ref": "#/$defs/orchestratorEntry" },
    "consistency_rules": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "draft_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "preset_draft_path", "instances_draft_path", "orchestrator_preset", "mount_required"],
      "properties": {
        "status": { "enum": ["draft", "mounted"] },
        "preset_draft_path": { "type": "string" },
        "instances_draft_path": { "type": "string" },
        "orchestrator_preset": { "type": "string" },
        "mount_required": { "type": "boolean", "const": false }
      }
    }
  },
  "$defs": {
    "roleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "preset", "policy_ref", "tool_instance", "tool_surface"],
      "properties": {
        "id": { "enum": ["zeko", "cto", "cfo", "kai", "somad", "badsector", "nova", "vera", "argus", "atlas", "tess", "quill", "scout", "talon", "ledger"] },
        "preset": { "type": "string", "pattern": "^role-[a-z]+$" },
        "policy_ref": { "type": "string", "pattern": "^agents/[a-z]+/policy\\.yaml$" },
        "tool_instance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_name", "provider", "max_depth", "agent_preset"],
          "properties": {
            "tool_name": { "const": "subagent", "$comment": "the ONE delegation tool; the role is chosen by the model-facing agent_preset argument, not by a per-role tool name" },
            "provider": { "const": "spawn" },
            "max_depth": { "type": "integer", "minimum": 1 },
            "agent_preset": { "type": "string", "pattern": "^role-[a-z]+$" }
          }
        },
        "tool_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "deny": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "orchestratorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "binding", "policy_ref", "delegation_tools", "tool_surface"],
      "properties": {
        "id": { "const": "orchestrator" },
        "binding": { "const": "root_session" },
        "policy_ref": { "type": "string" },
        "delegation_tools": {
          "type": "array",
          "items": { "enum": ["subagent", "subagent_fork", "send_message", "interrupt_agent", "list_agents", "workflow"] }
        },
        "tool_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "deny"],
          "properties": {
            "allow": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "deny": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "notes": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
