{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-harness.local/schemas/role-definition.schema.json",
  "title": "Agent role definition (policy.yaml)",
  "description": "Declarative role policy for one agent (agents/<id>/policy.yaml). Control-plane input; NOT native DSH authorization. Tool names verified against DSH 0.1.1-rc.2 catalog (docs/tool-catalog.md).",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "role_version", "status", "version_pin", "display_name", "domain", "summary", "capabilities", "sandbox_approval_intent", "tool_filter", "prohibited_actions", "invariants"],
  "properties": {
    "role": { "enum": ["zeko", "cto", "cfo", "kai", "somad", "badsector", "nova"] },
    "role_version": { "type": "integer", "minimum": 1 },
    "status": { "const": "finalized" },
    "version_pin": { "type": "string", "pattern": "^deepseek-harness-" },
    "display_name": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "enum": [
        "server_read", "server_write", "code_read", "code_write",
        "financial_analysis", "financial_transaction", "web_research",
        "social_drafting", "social_publishing", "novel_editing",
        "adversarial_review", "production_deploy", "destructive_action"
      ] },
      "patternProperties": {
        "^.*$": { "enum": ["yes", "scoped", "review", "approval", "scoped_approval", "no"] }
      }
    },
    "sandbox_approval_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "approval"],
      "properties": {
        "sandbox": { "enum": ["read-only", "workspace-write", "danger-full-access"] },
        "approval": { "enum": ["ask", "never"] }
      }
    },
    "tool_filter": { "$ref": "#/$defs/toolFilter" },
    "prohibited_actions": { "type": "array", "items": { "type": "string" } },
    "invariants": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "review_trigger": { "type": "string" }
  },
  "$defs": {
    "toolFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow", "deny"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unmounted_candidates": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
