{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-harness.local/schemas/l3/provenance.schema.json",
  "title": "L3 evidence provenance",
  "description": "Actor session tree, delegation chain, and child provenance for an L3 evidence bundle. Records who did what, under which delegation, with which run ids.",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id", "actor_session_id", "verifier_session_id",
    "delegation_chain", "children", "collection_order"
  ],
  "properties": {
    "scenario_id": { "type": "string", "pattern": "^L3-[A-Z]+-[0-9]{3}$" },
    "actor_session_id": { "type": "string", "minLength": 1 },
    "verifier_session_id": { "type": "string", "minLength": 1 },
    "delegation_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal", "delegate", "delegation_id", "action", "target", "status"],
        "properties": {
          "principal": { "type": "string", "enum": ["human"] },
          "delegate": { "type": "string", "enum": ["orchestrator", "zeko", "cto", "cfo", "kai", "somad", "badsector", "nova"] },
          "delegation_id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "scope": { "type": "object" },
          "status": { "type": "string", "enum": ["ACTIVE", "REVOKED", "EXPIRED"] },
          "version": { "type": "integer" },
          "created_at": { "type": ["string", "null"], "format": "date-time" },
          "revoked_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "role", "run_id", "tool_name", "stop_reason", "source"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["zeko", "cto", "cfo", "kai", "somad", "badsector", "nova"] },
          "run_id": { "type": "string", "minLength": 1 },
          "tool_name": { "type": "string", "pattern": "^subagent_[a-z]+$" },
          "stop_reason": { "type": "string", "enum": ["completed", "error", "aborted", "max-tokens", "refusal"] },
          "source": { "type": "string", "const": "RUNTIME-OBSERVED" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "settled_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "collection_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
