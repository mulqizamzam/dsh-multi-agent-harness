- insert:
    - id: mcp-omni
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: omni
        transport: stdio
        command: '/home/administrator/.local/bin/omni'
        args: ['--mcp']
        env:
          OMNI_AGENT_ID: 'dsh'
        cwd: '/home/administrator/agent-workspace'
        toolCallTimeoutMs: 60000
        failOnStartupError: true
    - id: tool-subagent-zeko
      name: '@deepseek-ai/dsh-tool-subagent'
      config:
        provider: spawn
        toolName: subagent_zeko
        persona: role-zeko
        backgroundMode: continuable
        maxDepth: 1
        toolFilter:
          allow: [bash, read, read_image, edit, write, glob, grep, job_kill, job_list, job_output, web_search, skill, exit_plan_mode, todo_write]
          deny: [subagent_zeko, subagent_cto, subagent_cfo, subagent_kai, subagent_somad, subagent_badsector, subagent_nova]
