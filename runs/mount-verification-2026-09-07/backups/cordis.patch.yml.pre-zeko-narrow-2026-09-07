    # TinyFish search provider (native @deepseek-ai/dsh-web-search-tinyfish):
    # registers the `tinyfish` provider on ctx.web. The key resolves from the
    # launch environment ($TINYFISH_API_KEY in $DSH_HOME/.env) — no literal
    # credential is stored here. $TINYFISH_BASE_URL overrides the endpoint
    # only when set to a non-empty value; anything else falls back to the
    # public default https://api.search.tinyfish.ai (an unparseable value
    # keeps the provider unavailable — fail closed, no silent endpoint swap).
    - id: web-search-tinyfish
      name: '@deepseek-ai/dsh-web-search-tinyfish'

- id: web-fetch-monid
  config:
    searchEnabled: true
    baseUrl: "https://api.monid.ai"

# Bounded search fallback (dsh-web-monid-fallback): caller-side wiring of
# searchWithFallback around ctx.web.search. A FAILED primary (transport
# failure / timeout / provider unavailable / malformed result) gets EXACTLY
# ONE Monid attempt inside ONE shared deadline (30 s total — the fallback
# receives only the remaining budget; the tool-level 60 s budget stays on top).
# A valid result — including empty sources[] — never falls back; caller abort
# always surfaces as WEB_ABORTED; WEB_PROVIDER_AMBIGUOUS is never masked.
# Requires the row above (searchEnabled: true) and $MONID_API_KEY; if Monid is
# unavailable at call time the primary error surfaces unchanged.
# Telemetry logs operational metadata only (path/outcome/latency) — no query,
# no secrets.
- id: dsh-web-monid-fallback
  config:
    enabled: true
    totalTimeoutMs: 30000
    telemetry: true

# web.searchProvider pins the search provider behind the standard web_search
# tool (dsh-tool-web -> ctx.web). tinyfish is the default; monid-search stays
# registered above (searchEnabled: true) as a separate, explicitly-selectable
# mechanism (env: DSH_WEB_SEARCH_PROVIDER=monid-search) — the seam itself never
# silently falls back between providers; the ONLY fallback in effect is the
# bounded, explicitly-mounted one wired by dsh-web-monid-fallback above.
- id: web
  config:
    searchProvider: tinyfish

# Enable the model-facing web_search tool (tool-web was shipped disabled by
# dsh-web-app; search-only — fetch stays off). Patch replaces the row's whole
# config, so restate the base bundle's values (search defaults stay active).
- id: tool-web
  config:
    fetch: false
    searchTimeoutMs: 60000
  disabled: false
