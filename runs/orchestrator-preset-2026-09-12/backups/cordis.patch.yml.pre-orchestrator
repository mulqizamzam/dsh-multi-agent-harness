    - id: mcp-omni
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: omni
        transport: stdio
        command: '/home/administrator/.local/bin/omni'
        args: ['--mcp']
        env:
          OMNI_AGENT_ID: 'dsh'
        cwd: '/home/administrator/agent-workspace'
        toolCallTimeoutMs: 60000
        failOnStartupError: true
    # Context Mode MCP — TRIAL (2026-09-10, owner-approved). MCP-only mode,
    # no hooks (riset: dok terkelola d4dac81c). 6 sandbox ctx_* tools + 5
    # meta tools over local SQLite FTS5; surfaces as
    # mcp__context_mode__ctx_*. LOCAL-FIRST: cloud forward opt-in only
    # (~/.context-mode/platform.json absent); automatic network = one npm
    # version-check GET. npm_config_cache + CONTEXT_MODE_DATA_DIR keep all
    # writes inside the workspace (npx EROFS-proof). Safe to remove.
    - id: mcp-context-mode
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: context_mode
        transport: stdio
        command: '/home/administrator/.nvm/versions/node/v24.19.0/bin/npx'
        args: ['-y', 'context-mode']
        env:
          npm_config_cache: '/home/administrator/agent-workspace/dsh-custom/plugins/research/.npm-cache'
          CONTEXT_MODE_DATA_DIR: '/home/administrator/agent-workspace/.dsh/context-mode-data'
        toolCallTimeoutMs: 120000
        failOnStartupError: false
