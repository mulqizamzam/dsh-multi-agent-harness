    # TinyFish search provider (native @deepseek-ai/dsh-web-search-tinyfish):
    # registers the `tinyfish` provider on ctx.web. The key resolves from the
    # launch environment ($TINYFISH_API_KEY in $DSH_HOME/.env) — no literal
    # credential is stored here. $TINYFISH_BASE_URL overrides the endpoint
    # only when set to a non-empty value; anything else falls back to the
    # public default https://api.search.tinyfish.ai (an unparseable value
    # keeps the provider unavailable — fail closed, no silent endpoint swap).
    - id: web-search-tinyfish
      name: '@deepseek-ai/dsh-web-search-tinyfish'

- id: web-fetch-monid
  config:
    searchEnabled: true
    baseUrl: "https://api.monid.ai"

# Bounded search fallback (dsh-web-monid-fallback) — DISABLED 2026-09-08:
# superseded by dsh-free-search (installed same day), whose unified engine
# chain already covers tinyfish -> firecrawl -> monid -> 8 free engines.
# Keeping both would retry Monid twice. Rollback: enabled: true.
- id: dsh-web-monid-fallback
  config:
    enabled: false
    totalTimeoutMs: 30000
    telemetry: true

# dsh-free-search 0.4.24-chain.1 (local build at ~/dsh-free-search-chain,
# installed 2026-09-08 as search fallback chain). Unified engine chain:
# preferred (tinyfish) -> firecrawl -> monid -> bing/anysearch/searxng/
# ddg/ddg-lite/exa/tavily/keenable, shared 30s budget, keys from env
# (TINYFISH_API_KEY, MONID_API_KEY) or credentials center.
# NOTE: the plugin registers ITSELF via its own bundle patch
# (package.json dsh.bundle.patch -> - insert: web-search-free,
# provider: tinyfish, bingMarket: zh-CN). Do NOT add a second insert
# here — duplicate loader id. The `web` row override below just hands
# the default searchProvider to it ("ddg" = the plugin's master provider,
# despite the name it routes to cfg.provider = tinyfish first).
# fetchProvider: http MUST be restated (patch = whole-row replace).

# web.searchProvider pins the search provider behind the standard web_search
# tool (dsh-tool-web -> ctx.web). Pointed at the free-search master provider
# ("ddg") on 2026-09-08 — the provider routes internally: tinyfish first,
# then firecrawl/monid, then free engines. monid-search remains registered
# above (searchEnabled: true) as an explicitly-selectable mechanism
# (env: DSH_WEB_SEARCH_PROVIDER=monid-search).
- id: web
  config:
    searchProvider: ddg
    fetchProvider: http

# Enable the model-facing web_search tool (tool-web was shipped disabled by
# dsh-web-app; search-only — fetch stays off). Patch replaces the row's whole
# config, so restate the base bundle's values (search defaults stay active).
- id: tool-web
  config:
    fetch: false
    searchTimeoutMs: 60000
  disabled: false
